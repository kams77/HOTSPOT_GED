# Serveur virtuel HotSpot Pro : authentification et comptabilité via SQL.
server default {

listen {
	type = auth
	ipaddr = *
	port = 0
	limits {
		max_connections = 16
		lifetime = 0
		idle_timeout = 30
	}
}

listen {
	type = acct
	ipaddr = *
	port = 0
}

authorize {
	filter_username
	preprocess
	chap
	mschap
	sql
	# Refuse les comptes dont la date Expiration est passée
	expiration
	# Applique Login-Time (plages horaires des forfaits)
	logintime
	# Temps cumulé (Max-All-Session)
	noresetcounter
	pap
}

authenticate {
	Auth-Type PAP {
		pap
	}
	Auth-Type CHAP {
		chap
	}
	Auth-Type MS-CHAP {
		mschap
	}
}

preacct {
	preprocess
	acct_unique
}

accounting {
	sql
	attr_filter.accounting_response
}

# Contrôle du nombre d'appareils simultanés (Simultaneous-Use)
session {
	sql
}

post-auth {
	sql
	Post-Auth-Type REJECT {
		sql
		attr_filter.access_reject
	}
}
}
