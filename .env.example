# Copiez ce fichier en .env et changez les mots de passe.

DB_NAME=radius
DB_USER=radius
DB_PASSWORD=changez-moi-db

DJANGO_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# En production derrière un domaine : https://hotspot.exemple.cd
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_URL=http://localhost:8000

# Compte super-administrateur créé au premier démarrage
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changez-moi-admin

# 1 = crée des données de test (revendeur, tickets, client « test »)
LOAD_DEMO=1

# Mobile Money : demo (confirmation automatique) ou http (agrégateur réel)
MOMO_PROVIDER=demo
MOMO_API_URL=
MOMO_API_KEY=
MOMO_WEBHOOK_SECRET=

# SMS : console (écrits dans le journal d'audit) ou http (fournisseur réel)
SMS_BACKEND=console
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=HotSpot
